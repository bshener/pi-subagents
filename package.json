{
  "name": "pi-subagents",
  "version": "0.1.0",
  "description": "A pi extension that exposes LLM tools to open Herdr panes and launch isolated pi subagents inside them.",
  "type": "module",
"main": "./src/index.ts",
"exports": {
".": "./src/index.ts"
},
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "pi -e ./src/index.ts"
  },
  "keywords": [
    "pi",
    "pi-extension"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "chalk": "^5.0.0",
    "typebox": "^1.3.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}
